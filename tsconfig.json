{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@docusaurus/theme-common/internal": [
        "./node_modules/@docusaurus/theme-common/lib/internal.d.ts"
      ]
    },
    "noUnusedLocals": true
  },
  "include": ["src"]
}
