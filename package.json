{
  "name": "quickinfo",
  "version": "0.1.0",
  "description": "Editor-style API hover tooltips for docs: signatures and docstrings on every API symbol in code blocks and prose. Docusaurus, Astro, Sphinx, MkDocs, or any other static site generator.",
  "keywords": [
    "api",
    "astro",
    "astro-integration",
    "code",
    "documentation",
    "docusaurus",
    "docusaurus-plugin",
    "hover",
    "mkdocs",
    "quickinfo",
    "sphinx",
    "tooltip"
  ],
  "homepage": "https://github.com/rachfop/quickinfo#readme",
  "bugs": {
    "url": "https://github.com/rachfop/quickinfo/issues"
  },
  "license": "MIT",
  "author": "Patrick Rachford",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachfop/quickinfo.git"
  },
  "bin": {
    "quickinfo": "lib/cli/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./docusaurus": {
      "types": "./lib/docusaurus/index.d.ts",
      "default": "./lib/docusaurus/index.js"
    },
    "./docusaurus/runtime": {
      "types": "./lib/docusaurus/runtime.d.ts",
      "default": "./lib/docusaurus/runtime.js"
    },
    "./rehype": {
      "types": "./lib/rehype.d.ts",
      "default": "./lib/rehype.js"
    },
    "./astro": {
      "types": "./lib/astro/index.d.ts",
      "default": "./lib/astro/index.js"
    },
    "./astro-client": {
      "types": "./lib/astro/client.d.ts",
      "default": "./lib/astro/client.js"
    },
    "./browser": "./lib/browser/quickinfo.js",
    "./styles": "./lib/browser/styles.css",
    "./data": "./lib/fallback-data.json",
    "./config": "./lib/fallback-config.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js && node scripts/bundle.js",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node tests/test-annotate.js",
    "prepublishOnly": "npm run build && npm test",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "node-html-parser": "9.0.4",
    "unist-util-visit": "4.1.2"
  },
  "devDependencies": {
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "20.6.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/unist": "^2.0.10",
    "esbuild": "0.28.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.64.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@docusaurus/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0"
  }
}
